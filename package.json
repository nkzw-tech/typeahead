{
  "name": "@nkzw/typeahead",
  "version": "1.0.0",
  "description": "An accessible, customizable React typeahead with Unicode-aware search.",
  "homepage": "https://github.com/nkzw-tech/typeahead",
  "license": "MIT",
  "author": {
    "name": "Christoph Nakazawa",
    "email": "christoph.pojer@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nkzw-tech/typeahead"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./core": {
      "types": "./lib/core.d.mts",
      "default": "./lib/core.mjs"
    },
    "./style.css": "./lib/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp dev --host 127.0.0.1",
    "prepare": "vp config",
    "ship": "vp run test:all && vp pm publish --access public",
    "test:browser": "playwright test",
    "test:package": "node scripts/test-package.ts"
  },
  "devDependencies": {
    "@nkzw/oxlint-config": "^3.0.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite-plus": "1.7.0",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
